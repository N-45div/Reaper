# Gemini API key (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Async driver REQUIRED (plain sqlite:// fails with DatabaseSessionService).
# Cloud Run + Cloud SQL: postgresql+asyncpg://USER:PW@/reaper?host=/cloudsql/PROJECT:REGION:INSTANCE
REAPER_DB_URL=sqlite+aiosqlite:///./data/reaper.db

REAPER_MODEL=gemini-3.5-flash

# Demo time compression: 1 real second = N simulated hours (0 = real time)
REAPER_TIME_COMPRESSION=0
