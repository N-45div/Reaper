# Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Async driver REQUIRED (plain sqlite:// fails with DatabaseSessionService).
# Cloud Run + Cloud SQL: postgresql+asyncpg://USER:PW@/reaper?host=/cloudsql/PROJECT:REGION:INSTANCE
REAPER_DB_URL=sqlite+aiosqlite:///./data/reaper.db
# Hosted (e.g. Neon/Cloud SQL): postgresql+asyncpg://USER:PW@HOST/DB?ssl=require

REAPER_MODEL=gemini-3.5-flash

# Evidence-chain backend: "sqlite" (local file) or "firestore" (Google Cloud).
# Firestore auth: gcloud auth application-default login
REAPER_LEDGER=sqlite
GOOGLE_CLOUD_PROJECT=
# Hosted deploys without ADC: paste the service-account key JSON (raw or base64)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Demo time compression: 1 real second = N simulated hours (0 = real time)
REAPER_TIME_COMPRESSION=0

# Optional: extra keys for quota rotation during long unattended runs
GOOGLE_API_KEYS=

# --- Phone approvals (Telegram: free, no card, no inbound ports) ---
# 1) message @BotFather -> /newbot -> paste the token here
# 2) message your bot once, open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy your chat id
REAPER_TELEGRAM_TOKEN=
REAPER_TELEGRAM_CHAT_ID=

# --- The Reaper-owned mailbox (no OAuth scope on YOUR account, ever) ---
# Make a dedicated Gmail, enable 2-Step Verification, mint an App Password at
# myaccount.google.com/apppasswords. Forward vendor mail to it, or create one
# filter you own. Reaper reads only this mailbox, headers first, and logs
# every open into hash chain 0.
REAPER_MAIL_USER=
REAPER_MAIL_APP_PASSWORD=
REAPER_OWNER_EMAIL=
REAPER_VENDOR_DOMAINS=

# --- Precedent memory (optional; BigQuery sandbox, no billing required) ---
# "off" (default) disables it entirely - no BigQuery import, no network call.
# "bigquery" enables read-only recall of how similar clauses resolved before.
# Setup:  python scripts/seed_precedents.py --create --from-fixtures --replace
REAPER_PRECEDENT=off
REAPER_BQ_DATASET=reaper_precedents
REAPER_BQ_TABLE=precedents
REAPER_BQ_LOCATION=US
REAPER_EMBED_MODEL=gemini-embedding-001
REAPER_EMBED_DIM=768
REAPER_PRECEDENT_MIN_SIMILARITY=0.72
REAPER_PRECEDENT_TIMEOUT_S=6
